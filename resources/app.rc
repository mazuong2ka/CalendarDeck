#include "resource.h"

IDI_CALENDAR_DECK ICON "calendar-deck.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,2,4,0
PRODUCTVERSION 0,2,4,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Calendar Deck - Weekly desktop calendar\0"
            VALUE "FileVersion", "0.2.4\0"
            VALUE "InternalName", "CalendarDeck\0"
            VALUE "OriginalFilename", "CalendarDeck.exe\0"
            VALUE "ProductName", "Calendar Deck\0"
            VALUE "ProductVersion", "0.2.4\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
